STREAMFORGE_ENV=development
STREAMFORGE_LOG_LEVEL=info
STREAMFORGE_HTTP_ADDR=:8080
STREAMFORGE_HTTP_READ_HEADER_TIMEOUT=5s
STREAMFORGE_HTTP_READ_TIMEOUT=10s
STREAMFORGE_HTTP_WRITE_TIMEOUT=15s
STREAMFORGE_HTTP_IDLE_TIMEOUT=60s
STREAMFORGE_SHUTDOWN_TIMEOUT=15s
STREAMFORGE_DATABASE_URL=postgres://streamforge:streamforge@localhost:5432/streamforge?sslmode=disable
STREAMFORGE_DATABASE_MAX_CONNS=20
STREAMFORGE_DATABASE_MIN_CONNS=2
STREAMFORGE_DATABASE_CONNECT_TIMEOUT=5s
STREAMFORGE_AUTH_JWT_ISSUER=streamforge
STREAMFORGE_AUTH_JWT_SECRET=development-only-change-this-signing-secret
STREAMFORGE_AUTH_ACCESS_TOKEN_TTL=15m
STREAMFORGE_AUTH_REFRESH_TOKEN_TTL=720h
STREAMFORGE_AUTH_LOGIN_RATE_LIMIT=5
STREAMFORGE_AUTH_LOGIN_RATE_WINDOW=1m
STREAMFORGE_AUTH_REGISTER_RATE_LIMIT=3
STREAMFORGE_AUTH_REGISTER_RATE_WINDOW=1h

POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge
POSTGRES_DB=streamforge
RABBITMQ_DEFAULT_USER=streamforge
RABBITMQ_DEFAULT_PASS=streamforge
MINIO_ROOT_USER=streamforge
MINIO_ROOT_PASSWORD=streamforge-local-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
